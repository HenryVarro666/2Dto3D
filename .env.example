# Copy to .env and export before starting the API (python -m pv3d). All values are optional.
# Bind address. Keep loopback unless an authenticating reverse proxy sits in front of the service.
PV3D_HOST=127.0.0.1
PV3D_PORT=8000
# DEBUG | INFO | WARNING | ERROR | CRITICAL ; text | json
PV3D_LOG_LEVEL=INFO
PV3D_LOG_FORMAT=text
# Comma-separated browser origins allowed to call the API cross-origin. Empty = same-origin only.
PV3D_CORS_ORIGINS=
# Durable state (SQLite ledger, normalized photos, job artifacts) and model cache.
PV3D_DATA_DIR=data/runtime
PV3D_MODEL_DIR=models/huggingface
# auto | cpu | mps | cuda
PV3D_DEVICE=auto
# Admission limit for queued + running inference jobs (1-64).
PV3D_MAX_PENDING_JOBS=8
# Hard stop for one isolated VGGT worker run, in seconds (60-86400).
PV3D_MULTIVIEW_TIMEOUT_S=1800
# Optional shared access token. When set, every /api call except /api/health needs
# "Authorization: Bearer <token>" or the session cookie minted by POST /api/session
# (the web app shows a sign-in field). At least 16 printable ASCII characters.
PV3D_API_TOKEN=
# Lifetime of the browser session cookie in seconds (60 to 2592000).
PV3D_SESSION_MAX_AGE_S=43200
